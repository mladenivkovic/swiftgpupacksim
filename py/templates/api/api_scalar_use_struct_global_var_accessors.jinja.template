{#  
    SPECIAL API:
    For APIs which make use of specific sub-structs of particle data, e.g.
    timestep_limiter_struct, rt_data etc, where we first need to access a
    specific struct.
#}
/**
 * @brief get {{NAME}}{% if HAS_DOC %}, {{DOC}}{% endif %}.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE {{TYPE}}
  part_get_{{NAME}}{{API_SUFFIX}}(const size_t pind) {

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}
  const struct {{ROOT_STRUCT}}* restrict d = part_get_const_{{ROOT_STRUCT_SPECIAL_NAME}}_p(pind);
  return {{ROOT_STRUCT_SPECIAL_NAME}}_get_{{NAME}}{{API_SUFFIX}}(d);

{%- if HAS_IFDEF and not IS_STRUCT %} {# return some default val if function contents are hidden behind macro #}
#else
  return {{IFDEF_RETURN_VAL}};
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}


/**
 * @brief get a pointer to {{NAME}}{% if HAS_DOC %}, {{DOC}}{% endif %}.
 * Use this only if you need to modify the value, i.e. if you need write access
 * to {{NAME}}. If you need read-only access to {{NAME}}, use {{ROOT_STRUCT}}_get_const_{{NAME}}_p() instead.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE {{TYPE}}*
  part_get_{{NAME}}_p{{API_SUFFIX}}(const size_t pind) {

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}
  struct {{ROOT_STRUCT}}* restrict d = part_get_{{ROOT_STRUCT_SPECIAL_NAME}}_p(pind);
  return {{ROOT_STRUCT_SPECIAL_NAME}}_get_{{NAME}}_p{{API_SUFFIX}}(d);

{%- if HAS_IFDEF and not IS_STRUCT %}
#else
  return NULL;
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}


/**
 * @brief get read-only access to pointer to {{NAME}}{% if not HAS_DOC %}.{% else %},
 * {{DOC}}.{% endif %}
 * If you need write access to {{NAME}}, use {{ROOT_STRUCT_SPECIAL_NAME}}_get_{{NAME}}_p() instead.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE const {{TYPE}}*
  part_get_const_{{NAME}}_p{{API_SUFFIX}}(const size_t pind) {

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}
  const struct {{ROOT_STRUCT}}* restrict d = part_get_const_{{ROOT_STRUCT_SPECIAL_NAME}}_p(pind);
  return {{ROOT_STRUCT_SPECIAL_NAME}}_get_const_{{NAME}}_p{{API_SUFFIX}}(d);

{%- if HAS_IFDEF and not IS_STRUCT %}
#else
  return NULL;
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}



/**
 * @brief set the value of {{NAME}}{% if HAS_DOC %}, {{DOC}}{% endif %}.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE void
  part_set_{{NAME}}{{API_SUFFIX}}(const size_t pind, const {{TYPE}} {{NAME}}){

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}
  struct {{ROOT_STRUCT}}* restrict d = part_get_{{ROOT_STRUCT_SPECIAL_NAME}}_p(pind);
  return {{ROOT_STRUCT_SPECIAL_NAME}}_set_{{NAME}}{{API_SUFFIX}}(d, {{NAME}});

{%- if HAS_IFDEF and not IS_STRUCT %}
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}
{# deliberately empty line #}
