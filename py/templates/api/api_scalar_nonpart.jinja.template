{#  
    SPECIAL API:
    For APIs of specific sub-structs of particle data, e.g. timestep_limiter_struct, rt_data etc.
    They take a struct as an argument, not any other accessor.
#}
/**
 * @brief get {{NAME}}{% if HAS_DOC %}, {{DOC}}{% endif %}.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE {{TYPE}}
  {{ROOT_STRUCT_SPECIAL_NAME}}_get_{{NAME}}{{API_SUFFIX}}(const struct {{ROOT_STRUCT}} *restrict {{ROOT_STRUCT_SPECIAL_NAME}}_s) {

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}

{%- if HAS_PARENT_STRUCT %}
  return {{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{PARENT_STRUCT}}._{{NAME}};
{%- else %}
  return {{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{NAME}};
{%- endif -%}

{%- if HAS_IFDEF and not IS_STRUCT %} {# return some default val if function contents are hidden behind macro #}
#else
  return {{IFDEF_RETURN_VAL}};
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}

/**
 * @brief get a pointer to {{NAME}}{% if HAS_DOC %}, {{DOC}}{% endif %}.
 * Use this only if you need to modify the value, i.e. if you need write access
 * to {{NAME}}. If you need read-only access to {{NAME}}, use {{ROOT_STRUCT}}_get_const_{{NAME}}_p() instead.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE {{TYPE}}*
  {{ROOT_STRUCT_SPECIAL_NAME}}_get_{{NAME}}_p{{API_SUFFIX}}(const struct {{ROOT_STRUCT}} *restrict {{ROOT_STRUCT_SPECIAL_NAME}}_s) {

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}

{%- if HAS_PARENT_STRUCT %}
  return &{{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{PARENT_STRUCT}}._{{NAME}};
{%- else %}
  return &{{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{NAME}};
{%- endif -%}

{%- if HAS_IFDEF and not IS_STRUCT %}
#else
  return NULL;
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}
{%- if not IS_POINTER %}

/**
 * @brief get read-only access to pointer to {{NAME}}{% if not HAS_DOC %}.{% else %},
 * {{DOC}}.{% endif %}
 * If you need write access to {{NAME}}, use {{ROOT_STRUCT_SPECIAL_NAME}}_get_{{NAME}}_p() instead.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE const {{TYPE}}*
  {{ROOT_STRUCT_SPECIAL_NAME}}_get_const_{{NAME}}_p{{API_SUFFIX}}(const struct {{ROOT_STRUCT}} *restrict {{ROOT_STRUCT_SPECIAL_NAME}}_s) {

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}

{%- if HAS_PARENT_STRUCT %}
  return &{{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{PARENT_STRUCT}}._{{NAME}};
{%- else %}
  return &{{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{NAME}};
{%- endif -%}

{%- if HAS_IFDEF and not IS_STRUCT %}
#else
  return NULL;
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}

{% endif -%}
/**
 * @brief set the value of {{NAME}}{% if HAS_DOC %}, {{DOC}}{% endif %}.
 */
{%- if HAS_IFDEF and IS_STRUCT %}
{#- we can't return a struct which is undefined because it's hidden behind a macro, so we have to hide the entire API. #}
#ifdef {{IFDEF}}
{%- endif %}
static __attribute__((always_inline)) INLINE void
  {{ROOT_STRUCT_SPECIAL_NAME}}_set_{{NAME}}{{API_SUFFIX}}(struct {{ROOT_STRUCT}} *restrict {{ROOT_STRUCT_SPECIAL_NAME}}_s, {% if not IS_POINTER -%} const {%- endif %} {{TYPE}} {{NAME}}) {

{%- if HAS_IFDEF and not IS_STRUCT %}
#ifdef {{IFDEF}}
{%- endif %}

{%- if HAS_PARENT_STRUCT %}
  {{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{PARENT_STRUCT}}._{{NAME}} = {{NAME}};
{%- else %}
  {{ROOT_STRUCT_SPECIAL_NAME}}_s->_{{NAME}} = {{NAME}};
{%- endif -%}

{%- if HAS_IFDEF and not IS_STRUCT %}
#endif
{%- endif %}
}
{% if HAS_IFDEF and IS_STRUCT -%}
#endif
{%- endif %}
{# deliberately empty line #}
